NEXT_PUBLIC_SITE_URL=https://www.5argny.com
NEXT_PUBLIC_API_URL=https://backend.5argny.com
NEXT_PUBLIC_ENV=production

# Optional verification tokens, rendered as google-site-verification and msvalidate.01.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Not secret: published at /<key>.txt. Must match the backend INDEXNOW_KEY.
# Use 8-128 letters, digits or hyphens. Leave unset to disable the endpoint.
INDEXNOW_KEY=

# Vercel provides VERCEL_ENV automatically (production, preview or development).
# On other hosts, set NEXT_PUBLIC_ENV=preview for non-production deployments.
# SEO_BUILD_DATE is injected by next.config.ts at build time; do not set it manually.
